
-- =====================================================
-- SHOPY FONT WALLET FOUNDATION
-- USD is the underlying ledger currency.
-- Local currency is for dashboard display only.
-- =====================================================

create extension if not exists pgcrypto;

-- 1. MEMBER WALLET ACCOUNTS
create table if not exists public.sf_wallet_accounts (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null unique
    references public.profiles(id) on delete restrict,
  balance_usd numeric(14,2) not null default 0
    check (balance_usd >= 0),
  pending_usd numeric(14,2) not null default 0
    check (pending_usd >= 0),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

-- 2. IMMUTABLE WALLET TRANSACTION HISTORY
create table if not exists public.sf_wallet_transactions (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null
    references public.profiles(id) on delete restrict,
  transaction_type text not null check (
    transaction_type in (
      'deposit',
      'withdrawal',
      'transfer_sent',
      'transfer_received',
      'earning',
      'commission',
      'purchase',
      'sale',
      'adjustment'
    )
  ),
  amount_usd numeric(14,2) not null check (amount_usd > 0),
  direction text not null check (direction in ('credit','debit')),
  reference text not null unique,
  description text,
  status text not null default 'pending' check (
    status in ('pending','completed','rejected','reversed')
  ),
  related_user_id uuid references public.profiles(id),
  created_at timestamptz not null default now()
);

create index if not exists sf_wallet_transactions_user_date_idx
on public.sf_wallet_transactions(user_id, created_at desc);

-- 3. MEMBER DEPOSIT REQUESTS
create table if not exists public.sf_wallet_deposits (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null
    references public.profiles(id) on delete restrict,
  amount_usd numeric(14,2) not null check (amount_usd > 0),
  payment_method text not null,
  payment_reference text,
  status text not null default 'pending'
    check (status in ('pending','approved','rejected')),
  admin_note text,
  reviewed_by uuid references public.profiles(id),
  reviewed_at timestamptz,
  created_at timestamptz not null default now()
);

create index if not exists sf_wallet_deposits_user_date_idx
on public.sf_wallet_deposits(user_id, created_at desc);

-- 4. VERIFIED WITHDRAWAL DESTINATIONS
create table if not exists public.sf_wallet_destinations (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null
    references public.profiles(id) on delete restrict,
  destination_type text not null,
  account_name text not null,
  account_number text not null,
  provider_name text,
  country text not null,
  currency text not null,
  is_verified boolean not null default false,
  verified_by uuid references public.profiles(id),
  verified_at timestamptz,
  created_at timestamptz not null default now()
);

create index if not exists sf_wallet_destinations_user_idx
on public.sf_wallet_destinations(user_id);

-- 5. WITHDRAWAL REQUESTS
create table if not exists public.sf_wallet_withdrawals (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null
    references public.profiles(id) on delete restrict,
  destination_id uuid not null
    references public.sf_wallet_destinations(id) on delete restrict,
  amount_usd numeric(14,2) not null check (amount_usd > 0),
  minimum_kes numeric(12,2) not null default 2000,
  status text not null default 'pending'
    check (status in ('pending','approved','paid','rejected')),
  payment_reference text,
  admin_note text,
  reviewed_by uuid references public.profiles(id),
  reviewed_at timestamptz,
  created_at timestamptz not null default now()
);

create index if not exists sf_wallet_withdrawals_user_date_idx
on public.sf_wallet_withdrawals(user_id, created_at desc);

-- 6. COUNTRY CURRENCY DISPLAY RATES
-- Rates are admin-managed. No invented exchange rates.
create table if not exists public.sf_wallet_fx_rates (
  currency_code text primary key,
  currency_name text not null,
  units_per_usd numeric(18,6)
    check (units_per_usd is null or units_per_usd > 0),
  updated_at timestamptz not null default now()
);

insert into public.sf_wallet_fx_rates
  (currency_code, currency_name, units_per_usd)
values
  ('KES', 'Kenyan Shilling', null),
  ('NGN', 'Nigerian Naira', null),
  ('GHS', 'Ghanaian Cedi', null),
  ('USD', 'US Dollar', 1)
on conflict (currency_code) do nothing;

-- 7. ENABLE ROW LEVEL SECURITY
alter table public.sf_wallet_accounts enable row level security;
alter table public.sf_wallet_transactions enable row level security;
alter table public.sf_wallet_deposits enable row level security;
alter table public.sf_wallet_destinations enable row level security;
alter table public.sf_wallet_withdrawals enable row level security;
alter table public.sf_wallet_fx_rates enable row level security;

-- 8. MEMBERS CAN ONLY READ THEIR OWN WALLET
drop policy if exists "sf wallet account owner read"
on public.sf_wallet_accounts;

create policy "sf wallet account owner read"
on public.sf_wallet_accounts
for select to authenticated
using (user_id = auth.uid() or public.scf_is_admin());

drop policy if exists "sf wallet transaction owner read"
on public.sf_wallet_transactions;

create policy "sf wallet transaction owner read"
on public.sf_wallet_transactions
for select to authenticated
using (user_id = auth.uid() or public.scf_is_admin());

drop policy if exists "sf wallet deposit owner read"
on public.sf_wallet_deposits;

create policy "sf wallet deposit owner read"
on public.sf_wallet_deposits
for select to authenticated
using (user_id = auth.uid() or public.scf_is_admin());

drop policy if exists "sf wallet destination owner read"
on public.sf_wallet_destinations;

create policy "sf wallet destination owner read"
on public.sf_wallet_destinations
for select to authenticated
using (user_id = auth.uid() or public.scf_is_admin());

drop policy if exists "sf wallet withdrawal owner read"
on public.sf_wallet_withdrawals;

create policy "sf wallet withdrawal owner read"
on public.sf_wallet_withdrawals
for select to authenticated
using (user_id = auth.uid() or public.scf_is_admin());

drop policy if exists "sf wallet fx public read"
on public.sf_wallet_fx_rates;

create policy "sf wallet fx public read"
on public.sf_wallet_fx_rates
for select to authenticated
using (true);

-- 9. CLIENT PERMISSIONS
-- Members cannot directly change balances or approve payments.
revoke all on public.sf_wallet_accounts
from anon, authenticated;

revoke all on public.sf_wallet_transactions
from anon, authenticated;

revoke all on public.sf_wallet_deposits
from anon, authenticated;

revoke all on public.sf_wallet_destinations
from anon, authenticated;

revoke all on public.sf_wallet_withdrawals
from anon, authenticated;

grant select on public.sf_wallet_accounts to authenticated;
grant select on public.sf_wallet_transactions to authenticated;
grant select on public.sf_wallet_deposits to authenticated;
grant select on public.sf_wallet_destinations to authenticated;
grant select on public.sf_wallet_withdrawals to authenticated;
grant select on public.sf_wallet_fx_rates to authenticated;

-- No client-side balance updates or payment approvals.
-- Secure server-side wallet functions will be added next.
