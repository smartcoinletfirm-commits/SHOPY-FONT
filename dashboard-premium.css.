
/* =========================================
   SHOPY FONT — PREMIUM MEMBER DASHBOARD
   Visual redesign only. Existing functions
   and Supabase connections remain untouched.
========================================= */

:root {
  --sf-navy: #101b30;
  --sf-green: #0d7655;
  --sf-green-dark: #09553e;
  --sf-gold: #d6ae60;
  --sf-ink: #172235;
  --sf-muted: #738092;
  --sf-line: #e5eaf0;
}

#dashboardView:has(#approvedDashboard:not(.hidden)) {
  max-width: 1160px;
  padding-top: 34px;
}

#approvedDashboard .stats-grid {
  display: none !important;
}

#sfMemberOverview {
  margin: 8px 0 34px !important;
  color: var(--sf-ink) !important;
}

/* Welcome header */
#sfMemberOverview .sf-dash-welcome {
  position: relative;
  overflow: hidden;
  min-height: 158px;
  padding: 28px 30px !important;
  border: 1px solid #203b5e;
  border-radius: 22px !important;
  background: linear-gradient(
    118deg,
    #101b30,
    #172d49 62%,
    #0d7655 145%
  ) !important;
  box-shadow: 0 18px 42px rgba(16,27,48,.13);
}

#sfMemberOverview .sf-dash-welcome:after {
  content: "";
  position: absolute;
  width: 210px;
  height: 210px;
  right: -55px;
  top: -100px;
  border: 1px solid rgba(214,174,96,.32);
  border-radius: 50%;
  box-shadow:
    0 0 0 24px rgba(214,174,96,.045),
    0 0 0 50px rgba(214,174,96,.035);
  pointer-events: none;
}

#sfMemberOverview .sf-dash-welcome small {
  color: #e3c98f !important;
  letter-spacing: 2px !important;
}

#sfMemberOverview .sf-dash-welcome h2 {
  font-family: Manrope, sans-serif;
  font-size: clamp(24px,4vw,34px) !important;
  letter-spacing: -.8px;
}

#sfMemberOverview .sf-dash-welcome p {
  color: #d0d9e5 !important;
}

#sfMemberOverview .sf-dash-status {
  position: relative;
  z-index: 1;
  border-color: #6ab493 !important;
  background: rgba(13,118,85,.2);
  color: #d8f5e5 !important;
  white-space: nowrap;
}

/* Wallet and account summary */
#sfMemberOverview .sf-dash-summary {
  grid-template-columns: minmax(0,.8fr) minmax(0,1.5fr) !important;
  gap: 14px !important;
  margin-top: 15px !important;
}

#sfMemberOverview .sf-dash-summary-card {
  min-height: 112px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 20px 22px !important;
  border: 1px solid var(--sf-line) !important;
  border-radius: 17px !important;
  background: #fff !important;
  box-shadow: 0 7px 22px rgba(16,27,48,.045);
}

#sfMemberOverview .sf-dash-summary-card span {
  color: #788598 !important;
  font-size: 10px !important;
  letter-spacing: 1.2px !important;
}

#sfMemberOverview .sf-dash-summary-card strong {
  color: var(--sf-ink) !important;
  font-family: Manrope, sans-serif;
  font-size: 26px !important;
}

#sfMemberOverview .sf-dash-summary-card.wallet {
  position: relative;
  overflow: hidden;
  border-color: var(--sf-green) !important;
  background: linear-gradient(
    115deg,
    #0b674a,
    #0d7655 70%,
    #16835f
  ) !important;
}

#sfMemberOverview .sf-dash-summary-card.wallet:after {
  content: "$";
  position: absolute;
  right: 20px;
  top: -18px;
  color: rgba(255,255,255,.09);
  font: bold 115px Manrope, sans-serif;
}

#sfMemberOverview .sf-dash-summary-card.wallet span {
  color: #d0eadf !important;
}

#sfMemberOverview .sf-dash-summary-card.wallet strong {
  position: relative;
  z-index: 1;
  color: #fff !important;
  font-size: 34px !important;
  letter-spacing: -1px;
}

/* Main dashboard sections */
#sfMemberOverview .sf-earning-opportunities,
#sfMemberOverview .sf-dash-referral {
  margin-top: 18px !important;
  padding: 22px !important;
  border: 1px solid var(--sf-line) !important;
  border-radius: 19px !important;
  background: #fff !important;
  box-shadow: 0 8px 25px rgba(16,27,48,.045);
}

#sfMemberOverview .sf-earning-opportunities h3,
#sfMemberOverview .sf-dash-workspace h3 {
  color: var(--sf-ink) !important;
  font-family: Manrope, sans-serif;
  font-size: 20px !important;
}

#sfMemberOverview .sf-earning-opportunities > p,
#sfMemberOverview .sf-dash-workspace > p,
#sfMemberOverview .sf-dash-referral p {
  color: var(--sf-muted) !important;
}

#sfMemberOverview .sf-earning-card {
  min-height: 150px !important;
  padding: 19px !important;
  border: 1px solid var(--sf-line) !important;
  border-radius: 16px !important;
  box-shadow: 0 5px 18px rgba(16,27,48,.035);
}

#sfMemberOverview .sf-earning-card.know {
  border-color: var(--sf-green) !important;
  background: linear-gradient(135deg,#0c6448,#0d7655) !important;
  box-shadow: 0 10px 22px rgba(13,118,85,.15);
}

#sfMemberOverview .sf-earning-card:not(.know) {
  background: #f8fafb !important;
}

#sfMemberOverview .sf-earning-card .sf-earning-cta {
  color: var(--sf-gold);
}

#sfMemberOverview .sf-earning-card:not(.know) .sf-earning-cta {
  color: var(--sf-green);
}

/* Referral centre */
#sfMemberOverview .sf-dash-kicker {
  color: var(--sf-green) !important;
}

#sfMemberOverview .sf-dash-referral h3 {
  color: var(--sf-ink) !important;
  font-family: Manrope, sans-serif;
}

#sfMemberOverview .sf-dash-linkrow input {
  border-color: #dce4e9 !important;
  border-radius: 10px !important;
  background: #f8fafb !important;
  color: #34445a !important;
}

#sfMemberOverview .sf-dash-btn {
  border-radius: 10px !important;
  background: var(--sf-navy) !important;
}

#sfMemberOverview .sf-dash-btn.green {
  background: #eaf5ef !important;
  color: #126344 !important;
  border: 1px solid #d2e8da !important;
}

#sfMemberOverview .sf-dash-ref-stats article {
  border: 1px solid var(--sf-line) !important;
  border-radius: 12px !important;
  background: #f9fbfc !important;
}

#sfMemberOverview .sf-dash-ref-stats strong {
  color: var(--sf-green) !important;
}

/* Workspace shortcut cards */
#sfMemberOverview .sf-dash-workspace {
  margin-top: 25px !important;
}

#sfMemberOverview .sf-quick-grid {
  gap: 13px !important;
}

#sfMemberOverview .sf-quick-card {
  min-height: 132px !important;
  padding: 17px !important;
  border: 1px solid var(--sf-line) !important;
  border-radius: 16px !important;
  background: #fff !important;
  box-shadow: 0 6px 20px rgba(16,27,48,.045) !important;
}

#sfMemberOverview .sf-quick-card:hover {
  border-color: #a9cdb9 !important;
  box-shadow: 0 12px 26px rgba(13,118,85,.09) !important;
}

#sfMemberOverview .sf-quick-icon {
  width: 39px !important;
  height: 39px !important;
  border-radius: 12px !important;
  background: #eaf5ef !important;
  color: var(--sf-green) !important;
}

#sfMemberOverview .sf-quick-card strong {
  color: var(--sf-ink) !important;
}

#sfMemberOverview .sf-quick-card small {
  color: var(--sf-muted) !important;
}

/* Withdrawal section */
#approvedDashboard #withdrawalSection {
  margin-top: 22px !important;
  padding: 24px !important;
  border: 1px solid var(--sf-line) !important;
  border-radius: 18px !important;
  box-shadow: 0 8px 25px rgba(16,27,48,.045);
}

#approvedDashboard #withdrawalSection h2 {
  font-family: Manrope, sans-serif;
  color: var(--sf-ink);
}

#approvedDashboard #withdrawalSection input {
  width: 100%;
  max-width: 520px;
  margin: 7px 0 15px;
  padding: 13px;
  border: 1px solid #dce4e9;
  border-radius: 10px;
}

/* Mobile layout */
@media(max-width:650px) {
  #dashboardView:has(#approvedDashboard:not(.hidden)) {
    padding: 24px 14px 48px;
  }

  #sfMemberOverview .sf-dash-welcome {
    padding: 22px 19px !important;
    border-radius: 18px !important;
  }

  #sfMemberOverview .sf-dash-summary {
    grid-template-columns: 1fr !important;
  }

  #sfMemberOverview .sf-dash-summary-card {
    min-height: 88px;
    padding: 16px 18px !important;
  }

  #sfMemberOverview .sf-dash-summary-card.wallet strong {
    font-size: 30px !important;
  }

  #sfMemberOverview .sf-earning-opportunities,
  #sfMemberOverview .sf-dash-referral {
    padding: 17px !important;
  }

  #sfMemberOverview .sf-earning-grid {
    grid-template-columns: 1fr !important;
  }

  #sfMemberOverview .sf-earning-card {
    min-height: 128px !important;
  }

  #sfMemberOverview .sf-quick-grid {
    grid-template-columns: repeat(2,minmax(0,1fr)) !important;
  }

  #sfMemberOverview .sf-quick-card {
    min-height: 122px !important;
    padding: 14px !important;
  }

  #sfMemberOverview .sf-dash-ref-stats {
    grid-template-columns: repeat(3,minmax(0,1fr)) !important;
  }

  #sfMemberOverview .sf-dash-ref-stats span {
    font-size: 9px !important;
    line-height: 1.4;
  }

  #sfMemberOverview .sf-dash-ref-stats strong {
    font-size: 18px !important;
  }

  #approvedDashboard #withdrawalSection {
    padding: 18px !important;
  }
}

@media(max-width:360px) {
  #sfMemberOverview .sf-quick-grid {
    grid-template-columns: 1fr !important;
  }
}
