/* SHOPY FONT — Member Dashboard Overview */
(function () {
  "use strict";

  const styles = `
    .sf-member-overview { margin: 22px 0 26px; }
    .sf-member-overview-head { margin: 0 0 14px; }
    .sf-member-overview-head h2 {
      margin: 0 0 6px;
      color: #101d36;
      font-size: 21px;
    }
    .sf-member-overview-head p {
      margin: 0;
      color: #718096;
      font-size: 12px;
      line-height: 1.6;
    }
    .sf-quick-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }
    .sf-quick-card {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 9px;
      min-height: 118px;
      padding: 17px;
      border: 1px solid #e6e9ef;
      border-radius: 12px;
      background: #fff;
      color: #17243a;
      text-align: left;
      cursor: pointer;
      transition: .18s ease;
    }
    .sf-quick-card:hover {
      border-color: #d8b56e;
      transform: translateY(-2px);
      box-shadow: 0 9px 24px rgba(16,29,54,.07);
    }
    .sf-quick-icon {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: #f7f1e5;
      color: #8b682d;
      font-size: 17px;
    }
    .sf-quick-card strong { font-size: 13px; }
    .sf-quick-card small {
      color: #718096;
      font-size: 10px;
      line-height: 1.4;
    }
    @media(max-width:700px) {
      .sf-quick-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media(max-width:380px) {
      .sf-quick-grid { grid-template-columns: 1fr; }
    }
  `;

  function renderOverview() {
    const root = document.getElementById("approvedDashboard");

    if (!root || root.classList.contains("hidden")) return;
    if (document.getElementById("sfMemberOverview")) return;

    if (!document.getElementById("sfMemberOverviewStyles")) {
      const style = document.createElement("style");
      style.id = "sfMemberOverviewStyles";
      style.textContent = styles;
      document.head.appendChild(style);
    }

    const section = document.createElement("section");
    section.id = "sfMemberOverview";
    section.className = "sf-member-overview";

    section.innerHTML = `
      <div class="sf-member-overview-head">
        <h2>Your workspace</h2>
        <p>Choose where you want to continue on SHOPY FONT.</p>
      </div>

      <div class="sf-quick-grid">

        <button class="sf-quick-card"
          type="button" data-view="marketplace">
          <span class="sf-quick-icon">▦</span>
          <strong>Marketplace</strong>
          <small>Explore approved products and seller space.</small>
        </button>

        <button class="sf-quick-card"
          type="button" data-view="opportunities">
          <span class="sf-quick-icon">↗</span>
          <strong>Opportunities</strong>
          <small>Explore campaigns, services and work.</small>
        </button>

/* ==========================================
   SHOPY FONT — GLOBAL CONNECTIVITY
   Continuous International Flag Strip
========================================== */

(function () {
  function addGlobalConnectivity() {
    const dashboard = document.getElementById("dashboardView");
    if (!dashboard) return;

    if (document.getElementById("sfGlobalConnectivity")) return;

    const countries = [
      ["🇰🇪", "Kenya"], ["🇺🇸", "USA"],
      ["🇬🇧", "UK"], ["🇨🇦", "Canada"],
      ["🇳🇬", "Nigeria"], ["🇬🇭", "Ghana"],
      ["🇿🇦", "South Africa"], ["🇦🇺", "Australia"],
      ["🇮🇳", "India"], ["🇨🇳", "China"],
      ["🇯🇵", "Japan"], ["🇩🇪", "Germany"],
      ["🇫🇷", "France"], ["🇧🇷", "Brazil"],
      ["🇸🇦", "Saudi Arabia"], ["🇦🇪", "UAE"],
      ["🇹🇿", "Tanzania"], ["🇺🇬", "Uganda"],
      ["🇷🇼", "Rwanda"], ["🇪🇬", "Egypt"],
      ["🇲🇽", "Mexico"], ["🇸🇬", "Singapore"],
      ["🇳🇿", "New Zealand"], ["🇮🇹", "Italy"],
      ["🇪🇸", "Spain"], ["🇳🇱", "Netherlands"],
      ["🇸🇪", "Sweden"], ["🇳🇴", "Norway"]
    ];

    const flags = countries.map(([flag, country]) =>
      `<span class="sf-global-flag" title="${country}">
        <span>${flag}</span>
        <small>${country}</small>
      </span>`
    ).join("");

    const section = document.createElement("section");
    section.id = "sfGlobalConnectivity";
    section.innerHTML = `
      <div class="sf-global-heading">
        <span class="sf-global-dot"></span>
        <div>
          <strong>GLOBAL CONNECTIVITY</strong>
          <small>193 COUNTRIES • ONE CONNECTED WORLD</small>
        </div>
      </div>
      <div class="sf-global-track">
        <div class="sf-global-moving">
          ${flags}${flags}
        </div>
      </div>
    `;

    dashboard.appendChild(section);

    if (!document.getElementById("sfGlobalConnectivityStyles")) {
      const style = document.createElement("style");
      style.id = "sfGlobalConnectivityStyles";
      style.textContent = `
        #sfGlobalConnectivity {
          width: 100%;
          margin: 30px 0 0;
          padding: 17px 0;
          overflow: hidden;
          background: linear-gradient(110deg,#062d25,#0c4939,#062d25);
          border-top: 1px solid rgba(212,175,55,.55);
          border-bottom: 1px solid rgba(212,175,55,.55);
          box-sizing: border-box;
        }

        .sf-global-heading {
          display: flex;
          align-items: center;
          gap: 10px;
          padding: 0 16px 14px;
          color: #fff;
        }

        .sf-global-heading strong {
          display: block;
          font-size: 12px;
          letter-spacing: 2px;
        }

        .sf-global-heading small {
          display: block;
          margin-top: 4px;
          font-size: 9px;
          letter-spacing: 1px;
          color: #d9c47b;
        }

        .sf-global-dot {
          width: 9px;
          height: 9px;
          flex-shrink: 0;
          border-radius: 50%;
          background: #d6b65e;
          box-shadow: 0 0 10px #d6b65e;
        }

        .sf-global-track {
          width: 100%;
          overflow: hidden;
        }

        .sf-global-moving {
          display: flex;
          width: max-content;
          align-items: center;
          gap: 25px;
          animation: sfGlobalGlide 65s linear infinite;
        }

        .sf-global-flag {
          display: flex;
          flex-direction: column;
          align-items: center;
          min-width: 48px;
          color: #fff;
        }

        .sf-global-flag span {
          font-size: 27px;
          line-height: 1.3;
        }

        .sf-global-flag small {
          margin-top: 3px;
          font-size: 9px;
          color: #e7e0cb;
        }

        @keyframes sfGlobalGlide {
          from { transform: translateX(0); }
          to { transform: translateX(-50%); }
        }

        @media (prefers-reduced-motion: reduce) {
          .sf-global-moving {
            animation: none;
          }
        }
      `;
      document.head.appendChild(style);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", addGlobalConnectivity);
  } else {
    addGlobalConnectivity();
  }

  // Re-add after dashboard content is refreshed.
  const originalLoadDashboard = window.SF && window.SF.loadDashboard;

  if (typeof originalLoadDashboard === "function") {
    window.SF.loadDashboard = async function (...args) {
      const result = await originalLoadDashboard.apply(this, args);
      addGlobalConnectivity();
      return result;
    };
  }
})();
