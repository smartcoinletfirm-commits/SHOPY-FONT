
/* ==========================================
   SHOPY FONT — GLOBAL CONNECTIVITY
   Continuous International Flag Strip
========================================== */

(function () {
  function addGlobalConnectivity() {
    const dashboard = document.getElementById("dashboardView");
    if (!dashboard) return;

    if (document.getElementById("sfGlobalConnectivity")) return;

    const countries = [
      ["🇰🇪", "Kenya"], ["🇺🇸", "USA"],
      ["🇬🇧", "UK"], ["🇨🇦", "Canada"],
      ["🇳🇬", "Nigeria"], ["🇬🇭", "Ghana"],
      ["🇿🇦", "South Africa"], ["🇦🇺", "Australia"],
      ["🇮🇳", "India"], ["🇨🇳", "China"],
      ["🇯🇵", "Japan"], ["🇩🇪", "Germany"],
      ["🇫🇷", "France"], ["🇧🇷", "Brazil"],
      ["🇸🇦", "Saudi Arabia"], ["🇦🇪", "UAE"],
      ["🇹🇿", "Tanzania"], ["🇺🇬", "Uganda"],
      ["🇷🇼", "Rwanda"], ["🇪🇬", "Egypt"],
      ["🇲🇽", "Mexico"], ["🇸🇬", "Singapore"],
      ["🇳🇿", "New Zealand"], ["🇮🇹", "Italy"],
      ["🇪🇸", "Spain"], ["🇳🇱", "Netherlands"],
      ["🇸🇪", "Sweden"], ["🇳🇴", "Norway"]
    ];

    const flags = countries.map(([flag, country]) =>
      `<span class="sf-global-flag" title="${country}">
        <span>${flag}</span>
        <small>${country}</small>
      </span>`
    ).join("");

    const section = document.createElement("section");
    section.id = "sfGlobalConnectivity";
    section.innerHTML = `
      <div class="sf-global-heading">
        <span class="sf-global-dot"></span>
        <div>
          <strong>GLOBAL CONNECTIVITY</strong>
          <small>193 COUNTRIES • ONE CONNECTED WORLD</small>
        </div>
      </div>
      <div class="sf-global-track">
        <div class="sf-global-moving">
          ${flags}${flags}
        </div>
      </div>
    `;

    dashboard.appendChild(section);

    if (!document.getElementById("sfGlobalConnectivityStyles")) {
      const style = document.createElement("style");
      style.id = "sfGlobalConnectivityStyles";
      style.textContent = `
        #sfGlobalConnectivity {
          width: 100%;
          margin: 30px 0 0;
          padding: 17px 0;
          overflow: hidden;
          background: linear-gradient(110deg,#062d25,#0c4939,#062d25);
          border-top: 1px solid rgba(212,175,55,.55);
          border-bottom: 1px solid rgba(212,175,55,.55);
          box-sizing: border-box;
        }

        .sf-global-heading {
          display: flex;
          align-items: center;
          gap: 10px;
          padding: 0 16px 14px;
          color: #fff;
        }

        .sf-global-heading strong {
          display: block;
          font-size: 12px;
          letter-spacing: 2px;
        }

        .sf-global-heading small {
          display: block;
          margin-top: 4px;
          font-size: 9px;
          letter-spacing: 1px;
          color: #d9c47b;
        }

        .sf-global-dot {
          width: 9px;
          height: 9px;
          flex-shrink: 0;
          border-radius: 50%;
          background: #d6b65e;
          box-shadow: 0 0 10px #d6b65e;
        }

        .sf-global-track {
          width: 100%;
          overflow: hidden;
        }

        .sf-global-moving {
          display: flex;
          width: max-content;
          align-items: center;
          gap: 25px;
          animation: sfGlobalGlide 65s linear infinite;
        }

        .sf-global-flag {
          display: flex;
          flex-direction: column;
          align-items: center;
          min-width: 48px;
          color: #fff;
        }

        .sf-global-flag span {
          font-size: 27px;
          line-height: 1.3;
        }

        .sf-global-flag small {
          margin-top: 3px;
          font-size: 9px;
          color: #e7e0cb;
        }

        @keyframes sfGlobalGlide {
          from { transform: translateX(0); }
          to { transform: translateX(-50%); }
        }

        @media (prefers-reduced-motion: reduce) {
          .sf-global-moving {
            animation: none;
          }
        }
      `;
      document.head.appendChild(style);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", addGlobalConnectivity);
  } else {
    addGlobalConnectivity();
  }

  // Re-add after dashboard content is refreshed.
  const originalLoadDashboard = window.SF && window.SF.loadDashboard;

  if (typeof originalLoadDashboard === "function") {
    window.SF.loadDashboard = async function (...args) {
      const result = await originalLoadDashboard.apply(this, args);
      addGlobalConnectivity();
      return result;
    };
  }
})();
