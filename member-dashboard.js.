/* SHOPY FONT — Member Dashboard Overview */
(function () {
  "use strict";

  const styles = `
    .sf-member-overview { margin: 22px 0 26px; }
    .sf-member-overview-head { margin: 0 0 14px; }
    .sf-member-overview-head h2 {
      margin: 0 0 6px;
      color: #101d36;
      font-size: 21px;
    }
    .sf-member-overview-head p {
      margin: 0;
      color: #718096;
      font-size: 12px;
      line-height: 1.6;
    }
    .sf-quick-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }
    .sf-quick-card {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 9px;
      min-height: 118px;
      padding: 17px;
      border: 1px solid #e6e9ef;
      border-radius: 12px;
      background: #fff;
      color: #17243a;
      text-align: left;
      cursor: pointer;
      transition: .18s ease;
    }
    .sf-quick-card:hover {
      border-color: #d8b56e;
      transform: translateY(-2px);
      box-shadow: 0 9px 24px rgba(16,29,54,.07);
    }
    .sf-quick-icon {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: #f7f1e5;
      color: #8b682d;
      font-size: 17px;
    }
    .sf-quick-card strong { font-size: 13px; }
    .sf-quick-card small {
      color: #718096;
      font-size: 10px;
      line-height: 1.4;
    }
    @media(max-width:700px) {
      .sf-quick-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media(max-width:380px) {
      .sf-quick-grid { grid-template-columns: 1fr; }
    }
  `;

  function renderOverview() {
    const root = document.getElementById("approvedDashboard");

    if (!root || root.classList.contains("hidden")) return;
    if (document.getElementById("sfMemberOverview")) return;

    if (!document.getElementById("sfMemberOverviewStyles")) {
      const style = document.createElement("style");
      style.id = "sfMemberOverviewStyles";
      style.textContent = styles;
      document.head.appendChild(style);
    }

    const section = document.createElement("section");
    section.id = "sfMemberOverview";
    section.className = "sf-member-overview";

    section.innerHTML = `
      <div class="sf-member-overview-head">
        <h2>Your workspace</h2>
        <p>Choose where you want to continue on SHOPY FONT.</p>
      </div>

      <div class="sf-quick-grid">

        <button class="sf-quick-card"
          type="button" data-view="marketplace">
          <span class="sf-quick-icon">▦</span>
          <strong>Marketplace</strong>
          <small>Explore approved products and seller space.</small>
        </button>

        <button class="sf-quick-card"
          type="button" data-view="opportunities">
          <span class="sf-quick-icon">↗</span>
          <strong>Opportunities</strong>
          <small>Explore campaigns, services and work.</small>
        </button>

        <button class="sf-quick-card"
          type="button" data-view="scholarbridge">
          <span class="sf-quick-icon">✎</span>
          <strong>ScholarBridge</strong>
          <small>Open learning and academic support.</small>
        </button>

        <button class="sf-quick-card"
          type="button" data-view="referrals">
          <span class="sf-quick-icon">♧</span>
          <strong>Referral centre</strong>
          <small>View and share your referral link.</small>
        </button>

      </div>
    `;

    const stats = root.querySelector(".stats-grid");

    if (stats) {
      stats.insertAdjacentElement("afterend", section);
    } else {
      root.prepend(section);
    }
  }

  function install() {
    if (
      window.SF &&
      typeof window.SF.loadDashboard === "function" &&
      !window.SF.__memberOverviewWrapped
    ) {
      const original = window.SF.loadDashboard;

      window.SF.loadDashboard = async function () {
        const result = await original.apply(this, arguments);
        renderOverview();
        return result;
      };

      window.SF.__memberOverviewWrapped = true;
    }

    renderOverview();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", install);
  } else {
    install();
  }
})();

